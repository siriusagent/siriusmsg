{
  "name": "@siriusmsg/sdk",
  "version": "1.0.0",
  "description": "Generated types and Node NDJSON client for the SiriusMsg local service protocol.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/_schema.json dist/_schema.json",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "22.12.0",
    "json-schema-to-typescript": "15.0.4",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
